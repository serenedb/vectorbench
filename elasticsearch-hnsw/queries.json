{
  "none/*": {"filter": null, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "eq-10/*": {"filter": {"term": {"cat10": "$v"}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "eq-1/*": {"filter": {"term": {"cat100": "$v"}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "eq-0.1/*": {"filter": {"term": {"cat1000": "$v"}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "range-10/*": {"filter": {"range": {"num": {"gte": "$lo", "lte": "$hi"}}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "range-1/*": {"filter": {"range": {"num": {"gte": "$lo", "lte": "$hi"}}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "and-1/*": {"filter": {"bool": {"filter": [{"term": {"cat10": "$v"}}, {"range": {"num": {"gte": "$lo", "lte": "$hi"}}}]}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "corr/*": {"filter": {"term": {"cluster": "$v"}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "xcorr/*": {"filter": {"term": {"cluster": "$v"}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "lang/*": {"filter": {"term": {"lang": "$s"}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "xlang/*": {"filter": {"term": {"lang": "$s"}}, "num_candidates": "{num_candidates}", "rescore_oversample": "{oversample}"},
  "exact/none/*": {"filter": null, "exact": true},
  "exact/eq-1/*": {"filter": {"term": {"cat100": "$v"}}, "exact": true}
}
