#!/usr/bin/env bash
# One-time setup: have the image present (pull only if the tag is not local), remove any container of
# this name and wipe the engine directory, so ./load builds from an empty engine (a leftover index would
# give a bogus instant load time).
set -euo pipefail
cd "$(dirname "$0")"

: "${VB_IMAGE:=qdrant/qdrant:v1.19.1}"
: "${VB_CONTAINER:=vectorbench-qdrant-hnsw}"
: "${VECTORBENCH_ENGINE_DIR:?VECTORBENCH_ENGINE_DIR must be set (the engine storage directory)}"

command -v docker >/dev/null || { echo "docker not on PATH" >&2; exit 1; }
command -v curl   >/dev/null || { echo "curl not on PATH"   >&2; exit 1; }
docker info >/dev/null 2>&1  || { echo "docker daemon not reachable" >&2; exit 1; }

# ./load and client.py run on the host: the same interpreter ./load will use must have the drivers.
python=${VECTORBENCH_PYTHON:-}
if [[ -z "$python" ]]; then
    if [[ -x ../.venv/bin/python ]]; then python=../.venv/bin/python; else python=python3; fi
fi
"$python" -c 'import numpy, pyarrow, qdrant_client' 2>/dev/null \
    || { echo "$python lacks numpy, pyarrow or qdrant_client (needed by ./load and client.py)" >&2; exit 1; }

echo "Qdrant image: $VB_IMAGE"
# Pull only what we do not already have. A locally built or `docker load`ed image exists nowhere else,
# and `docker pull` of a tag no registry serves fails outright, which under set -e would abort the run
# before it started. Present locally is reason enough; a published tag still gets pulled on first use.
if docker image inspect "$VB_IMAGE" >/dev/null 2>&1; then
    echo "  using local image (not pulling)"
else
    docker pull --quiet "$VB_IMAGE" >/dev/null
fi

docker rm -f "$VB_CONTAINER" >/dev/null 2>&1 || true

# The container runs as root, so whatever it wrote into the bind mount cannot be removed by the host
# user; when a plain rm leaves anything behind, finish from a throwaway root container of the same image.
if [[ -e "$VECTORBENCH_ENGINE_DIR" ]]; then
    rm -rf "$VECTORBENCH_ENGINE_DIR" 2>/dev/null || true
    if [[ -e "$VECTORBENCH_ENGINE_DIR" ]]; then
        parent=$(cd "$(dirname "$VECTORBENCH_ENGINE_DIR")" && pwd)
        docker run --rm --user 0:0 --entrypoint rm -v "${parent}:/w" "$VB_IMAGE" \
            -rf "/w/$(basename "$VECTORBENCH_ENGINE_DIR")"
    fi
fi
mkdir -p "$VECTORBENCH_ENGINE_DIR"
