{
  "none/*": {"filter": null, "params": {"hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "eq-10/*": {"filter": {"must": [{"key": "cat10", "match": {"value": "$v"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "eq-1/*": {"filter": {"must": [{"key": "cat100", "match": {"value": "$v"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "eq-0.1/*": {"filter": {"must": [{"key": "cat1000", "match": {"value": "$v"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "range-10/*": {"filter": {"must": [{"key": "num", "range": {"gte": "$lo", "lte": "$hi"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "range-1/*": {"filter": {"must": [{"key": "num", "range": {"gte": "$lo", "lte": "$hi"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "and-1/*": {"filter": {"must": [{"key": "cat10", "match": {"value": "$v"}}, {"key": "num", "range": {"gte": "$lo", "lte": "$hi"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "corr/*": {"filter": {"must": [{"key": "cluster", "match": {"value": "$v"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "xcorr/*": {"filter": {"must": [{"key": "cluster", "match": {"value": "$v"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "lang/*": {"filter": {"must": [{"key": "lang", "match": {"value": "$s"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "xlang/*": {"filter": {"must": [{"key": "lang", "match": {"value": "$s"}}]}, "params": {"acorn": true, "hnsw_ef": "{hnsw_ef}", "quantization": {"rescore": "{index.rescore}", "oversampling": "{oversample}"}}},
  "exact/none/*": {"filter": null, "params": {"exact": true}},
  "exact/eq-1/*": {"filter": {"must": [{"key": "cat100", "match": {"value": "$v"}}]}, "params": {"exact": true}}
}
