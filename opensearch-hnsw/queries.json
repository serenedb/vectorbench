{
  "none/*": {"filter": null, "ef_search": "{ef_search}"},
  "eq-10/*": {"filter": {"term": {"cat10": "$v"}}, "ef_search": "{ef_search}"},
  "eq-1/*": {"filter": {"term": {"cat100": "$v"}}, "ef_search": "{ef_search}"},
  "eq-0.1/*": {"filter": {"term": {"cat1000": "$v"}}, "ef_search": "{ef_search}"},
  "range-10/*": {"filter": {"range": {"num": {"gte": "$lo", "lte": "$hi"}}}, "ef_search": "{ef_search}"},
  "range-1/*": {"filter": {"range": {"num": {"gte": "$lo", "lte": "$hi"}}}, "ef_search": "{ef_search}"},
  "and-1/*": {"filter": {"bool": {"filter": [{"term": {"cat10": "$v"}}, {"range": {"num": {"gte": "$lo", "lte": "$hi"}}}]}}, "ef_search": "{ef_search}"},
  "corr/*": {"filter": {"term": {"cluster": "$v"}}, "ef_search": "{ef_search}"},
  "xcorr/*": {"filter": {"term": {"cluster": "$v"}}, "ef_search": "{ef_search}"},
  "lang/*": {"filter": {"term": {"lang": "$s"}}, "ef_search": "{ef_search}"},
  "xlang/*": {"filter": {"term": {"lang": "$s"}}, "ef_search": "{ef_search}"},
  "exact/none/*": {"filter": null, "exact": true},
  "exact/eq-1/*": {"filter": {"term": {"cat100": "$v"}}, "exact": true}
}
